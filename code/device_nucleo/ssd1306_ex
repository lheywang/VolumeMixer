/**
 * @brief  Sends a command byte to the SSD1306 via I2C DMA.
 * @param  command: The command byte to send.
 * @retval None
 */
void SSD1306_SendCommand(uint8_t command)
{
    // The first byte of the transfer is the control byte.
    // For commands, it's 0x00.
    uint8_t i2c_tx_buffer[2] = {SSD1306_COMMAND_MODE, command};

    // Use HAL_I2C_Master_Transmit_DMA to send the command
    // SSD1306_I2C_ADDR is the 8-bit address (0x3C << 1)
    // i2c_tx_buffer is the data to send
    // 2 is the length of the data (control byte + command byte)
    // HAL_MAX_DELAY is the timeout for the function itself, though DMA is asynchronous
    if (HAL_I2C_Master_Transmit_DMA(&hi2c1, SSD1306_I2C_ADDR, i2c_tx_buffer, 2) != HAL_OK)
    {
        Error_Handler();
    }
    // Wait for the DMA transfer to complete (you might use a callback for non-blocking)
    while (HAL_I2C_GetState(&hi2c1) != HAL_I2C_STATE_READY) {}
}

/**
 * @brief  Sends data (e.g., pixel data) to the SSD1306 via I2C DMA.
 * @param  data: Pointer to the data buffer.
 * @param  len: Length of the data to send.
 * @retval None
 */
void SSD1306_SendData(uint8_t *data, uint16_t len)
{
    // For data, the control byte is 0x40.
    // We need to send a single control byte followed by 'len' data bytes.
    // HAL_I2C_Master_Transmit_DMA handles prepending the address.
    // The data buffer itself needs to include the control byte at the beginning.
    // A more efficient way for large data transfers is to modify the buffer in-place
    // or use a temporary buffer. For simplicity, we'll allocate here.
    uint8_t *i2c_tx_buffer = malloc(len + 1);
    if (i2c_tx_buffer == NULL) {
        Error_Handler(); // Handle memory allocation failure
    }
    i2c_tx_buffer[0] = SSD1306_DATA_MODE;
    memcpy(&i2c_tx_buffer[1], data, len);

    if (HAL_I2C_Master_Transmit_DMA(&hi2c1, SSD1306_I2C_ADDR, i2c_tx_buffer, len + 1) != HAL_OK)
    {
        free(i2c_tx_buffer); // Free memory on error
        Error_Handler();
    }
    // Wait for the DMA transfer to complete
    while (HAL_I2C_GetState(&hi2c1) != HAL_I2C_STATE_READY) {}
    free(i2c_tx_buffer); // Free the dynamically allocated buffer
}


/**
 * @brief  Initializes the SSD1306 OLED display with basic settings.
 * @retval None
 * This is a common initialization sequence for 128x64 SSD1306 displays.
 */
void SSD1306_Init(void)
{
    // Power up delay, if needed
    HAL_Delay(100);

    SSD1306_SendCommand(0xAE); // Display OFF

    SSD1306_SendCommand(0x20); // Set Memory Addressing Mode
    SSD1306_SendCommand(0x00); // 00b = Horizontal Addressing Mode; 01b = Vertical Addressing Mode; 10b = Page Addressing Mode (RESET);

    SSD1306_SendCommand(0xB0); // Set Page Start Address for Page Addressing Mode, 0-7

    SSD1306_SendCommand(0xC8); // Set COM Output Scan Direction

    SSD1306_SendCommand(0x00); // Set Lower Column Start Address for Page Addressing Mode
    SSD1306_SendCommand(0x10); // Set Higher Column Start Address for Page Addressing Mode

    SSD1306_SendCommand(0x40); // Set Start Line Address

    SSD1306_SendCommand(0x81); // Set Contrast Control Register
    SSD1306_SendCommand(0xFF); // Full contrast (0x00-0xFF)

    SSD1306_SendCommand(0xA1); // Set Segment Re-map (A0=reset, A1=Set)

    SSD1306_SendCommand(0xA6); // Set Normal Display (A7=Inverse Display)

    SSD1306_SendCommand(0xA8); // Set Multiplex Ratio
    SSD1306_SendCommand(0x3F); // 63MUX (for 64-pixel high display)

    SSD1306_SendCommand(0xA4); // Entire Display OFF (A5=Entire Display ON)

    SSD1306_SendCommand(0xD3); // Set Display Offset
    SSD1306_SendCommand(0x00); // No Offset

    SSD1306_SendCommand(0xD5); // Set Display Clock Divide Ratio/Oscillator Frequency
    SSD1306_SendCommand(0xF0); // Default DCLK is 0xF0

    SSD1306_SendCommand(0xD9); // Set Pre-charge Period
    SSD1306_SendCommand(0x22);

    SSD1306_SendCommand(0xDA); // Set COM Pins Hardware Configuration
    SSD1306_SendCommand(0x12); // For 128x64, COM are odd-even (0x12)

    SSD1306_SendCommand(0xDB); // Set VCOMH Deselect Level
    SSD1306_SendCommand(0x20); // 0.77 * VCC (typical)

    SSD1306_SendCommand(0x8D); // Charge Pump Setting
    SSD1306_SendCommand(0x14); // Enable Charge Pump (0x14)

    SSD1306_SendCommand(0xAF); // Display ON
}

/**
 * @brief  Fills the SSD1306 display buffer with a specified pattern.
 * @param  pattern: The byte value to fill the buffer with.
 * @retval None
 */
void SSD1306_Fill(uint8_t pattern)
{
    memset(SSD1306_Buffer, pattern, sizeof(SSD1306_Buffer));
}

/**
 * @brief  Updates the SSD1306 display by sending the content of the frame buffer.
 * @retval None
 */
void SSD1306_UpdateDisplay(void)
{
    // Set column and page start/end addresses
    SSD1306_SendCommand(0x21); // Set Column Address
    SSD1306_SendCommand(0x00); // Column Start Address
    SSD1306_SendCommand(SSD1306_WIDTH - 1); // Column End Address (127)

    SSD1306_SendCommand(0x22); // Set Page Address
    SSD1306_SendCommand(0x00); // Page Start Address
    SSD1306_SendCommand((SSD1306_HEIGHT / 8) - 1); // Page End Address (7 for 64-pixel high)

    // Send the entire buffer as data
    SSD1306_SendData(SSD1306_Buffer, sizeof(SSD1306_Buffer));
}

