/*
 * This code demonstrates I2C communication with DMA for an SSD1306 OLED display.
 * It configures I2C1 for master mode and DMA for transmitting data to the OLED.
 *
 * Requirements:
 * - STM32CubeIDE or similar development environment configured for your Nucleo board.
 * - I2C1 configured (typically PB6 for SCL, PB7 for SDA) in Master mode.
 * - DMA configured for I2C1_TX (usually DMA1 Channel 6 or similar, depending on MCU).
 * - An SSD1306 OLED display connected to I2C1 (SCL to PB6, SDA to PB7).
 * - This example focuses on the DMA transfer mechanism and basic display initialization.
 * A full SSD1306 driver would be more extensive.
 *
 * This example assumes:
 * - SSD1306 OLED with I2C address 0x3C (7-bit address).
 * - 128x64 resolution.
 */

/* Includes ------------------------------------------------------------------*/
#include "main.h"      // Includes board-specific configurations, HAL, etc.
#include <string.h>    // Required for memset

/* Private variables ---------------------------------------------------------*/
I2C_HandleTypeDef hi2c1; // Handle for I2C1 peripheral
DMA_HandleTypeDef hdma_i2c1_tx; // Handle for I2C1 TX DMA channel

/* SSD1306 Defines -----------------------------------------------------------*/
#define SSD1306_I2C_ADDR    (0x3C << 1) // 7-bit address 0x3C, left-shifted for 8-bit HAL functions
#define SSD1306_WIDTH       128
#define SSD1306_HEIGHT      64

// SSD1306 command byte (0x00) and data byte (0x40)
#define SSD1306_COMMAND_MODE    0x00
#define SSD1306_DATA_MODE       0x40

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_DMA_Init(void);      // Initialize DMA controller
static void MX_I2C1_Init(void);     // Initialize I2C1 peripheral
void Error_Handler(void);

// Function to send commands to the SSD1306 via I2C DMA
void SSD1306_SendCommand(uint8_t command);
// Function to send data (e.g., pixel data) to the SSD1306 via I2C DMA
void SSD1306_SendData(uint8_t *data, uint16_t len);
// Basic SSD1306 initialization sequence
void SSD1306_Init(void);
// Function to clear the display buffer
void SSD1306_Fill(uint8_t pattern);
// Basic function to update the display (send frame buffer)
void SSD1306_UpdateDisplay(void);

// Dummy frame buffer (for 128x64 display, 8 pixels per byte, 8 pages)
uint8_t SSD1306_Buffer[SSD1306_WIDTH * (SSD1306_HEIGHT / 8)];

/**
 * @brief  The application entry point.
 * @retval int
 */
int main(void)
{
  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* Configure the system clock */
  SystemClock_Config();

  /* Initialize all configured peripherals */
  MX_GPIO_Init();   // Initialize GPIO pins for I2C
  MX_DMA_Init();    // Initialize DMA controller
  MX_I2C1_Init();   // Initialize I2C1

  // Initialize the SSD1306 OLED display
  SSD1306_Init();
  HAL_Delay(100); // Give some time for display to settle

  // Clear the display buffer initially
  SSD1306_Fill(0x00); // Fill with all zeros (display off)
  SSD1306_UpdateDisplay(); // Send the cleared buffer to display
  HAL_Delay(500);

  // Example: Fill with a pattern (e.g., checkerboard or lines)
  SSD1306_Fill(0xAA); // Fill with alternating pixels
  SSD1306_UpdateDisplay();
  HAL_Delay(1000);

  SSD1306_Fill(0x55); // Fill with inverse alternating pixels
  SSD1306_UpdateDisplay();
  HAL_Delay(1000);

  SSD1306_Fill(0xF0); // Fill top half of character with on pixels
  SSD1306_UpdateDisplay();
  HAL_Delay(1000);

  SSD1306_Fill(0x0F); // Fill bottom half of character with on pixels
  SSD1306_UpdateDisplay();
  HAL_Delay(1000);

  /* Infinite loop */
  while (1)
  {
    // You can add more complex display logic here, e.g., drawing text,
    // graphics, or updating values based on sensor readings.
    // For this example, we'll just keep updating with different patterns.
    SSD1306_Fill(0xAA);
    SSD1306_UpdateDisplay();
    HAL_Delay(500);

    SSD1306_Fill(0x55);
    SSD1306_UpdateDisplay();
    HAL_Delay(500);
  }
}

