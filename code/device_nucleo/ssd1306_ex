/**
  * @brief I2C1 Initialization Function
  * @param None
  * @retval None
  * Configures I2C1 in Fast Mode (400kHz) with no Own Address.
  * Assumes clock for I2C1 is enabled via CubeMX setup.
  */
static void MX_I2C1_Init(void)
{
  hi2c1.Instance = I2C1;
  hi2c1.Init.ClockSpeed = 400000; // Fast Mode: 400 kHz
  hi2c1.Init.DutyCycle = I2C_DUTYCYCLE_2; // Fast Mode duty cycle
  hi2c1.Init.OwnAddress1 = 0; // No own address for master mode
  hi2c1.Init.AddressingMode = I2C_ADDRESSINGMODE_7BIT;
  hi2c1.Init.DualAddressMode = I2C_DUALADDRESS_DISABLE;
  hi2c1.Init.OwnAddress2 = 0;
  hi2c1.Init.GeneralCallMode = I2C_GENERALCALL_DISABLE;
  hi2c1.Init.NoStretchMode = I2C_NOSTRETCH_DISABLE;
  if (HAL_I2C_Init(&hi2c1) != HAL_OK)
  {
    Error_Handler();
  }
}

